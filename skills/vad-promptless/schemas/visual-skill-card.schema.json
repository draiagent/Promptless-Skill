{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/draiagent/VAD-Promptless/blob/main/skills/vad-promptless/schemas/visual-skill-card.schema.json",
  "title":"Promptless Visual Skill Card Schema",
  "description":"VAD-Promptless v0.4.0 的 Visual Skill Card 機器可讀規格。",
  "type":"object","additionalProperties":false,
  "required":["schema_version","card_type","id","name","metadata","task","input","process","output","qa","execution","upgrade_policy"],
  "properties":{
    "schema_version":{"const":"0.3.0"},"card_type":{"const":"skill"},
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},"name":{"type":"string","minLength":1},"description":{"type":"string"},"language":{"type":"string","default":"zh-TW"},
    "metadata":{"type":"object","additionalProperties":false,"required":["version"],"properties":{"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"author":{"type":"string"},"license":{"type":"string"},"tags":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
    "task":{"type":"object","additionalProperties":false,"required":["objective","success_definition"],"properties":{"objective":{"type":"string","minLength":1},"task_type":{"type":"string"},"success_definition":{"type":"string","minLength":1}}},
    "input":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","type","required"],"properties":{"name":{"type":"string","minLength":1},"type":{"type":"string","enum":["text","image","pdf","document","spreadsheet","audio","video","url","database","api","json","yaml","file","other"]},"required":{"type":"boolean"},"description":{"type":"string"},"accepts":{"type":"array","items":{"type":"string"}},"source":{"type":"string"}}}},
    "style":{"type":"object","additionalProperties":false,"properties":{"language":{"type":"string"},"tone":{"type":"string"},"brand":{"type":"string"},"format_constraints":{"type":"array","items":{"type":"string"}},"content_constraints":{"type":"array","items":{"type":"string"}}}},
    "process":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","action"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9._-]+$"},"name":{"type":"string"},"action":{"type":"string","minLength":1},"condition":{"type":"string"},"skill":{"type":"string"},"tool":{"type":"string"},"input_refs":{"type":"array","items":{"type":"string"}},"output_refs":{"type":"array","items":{"type":"string"}},"on_failure":{"type":"string","enum":["stop","retry","human_review","continue","replan"]}}}},
    "output":{"type":"object","additionalProperties":false,"required":["artifacts"],"properties":{"artifacts":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","type"],"properties":{"name":{"type":"string"},"type":{"type":"string"},"format":{"type":"string"},"required":{"type":"boolean","default":true},"schema_ref":{"type":"string"}}}},"delivery":{"type":"string"}}},
    "qa":{"type":"object","additionalProperties":false,"required":["checks","pass_policy"],"properties":{"checks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","criterion","severity","method"],"properties":{"id":{"type":"string"},"criterion":{"type":"string"},"severity":{"enum":["blocker","warning","info"]},"method":{"enum":["schema","model","tool","human"]},"threshold":{"type":["number","string","boolean"]}}}},"pass_policy":{"enum":["all_blockers","all_checks","weighted","human_final"]}}},
    "execution":{"type":"object","additionalProperties":false,"required":["autonomy_level","dynamic_branching","dynamic_tool_selection","replanning","persistent_state","delegation","multi_agent","external_side_effects"],"properties":{"autonomy_level":{"type":"integer","minimum":0,"maximum":5},"dynamic_branching":{"type":"boolean"},"dynamic_tool_selection":{"type":"boolean"},"replanning":{"type":"boolean"},"persistent_state":{"type":"boolean"},"delegation":{"type":"boolean"},"multi_agent":{"type":"boolean"},"external_side_effects":{"type":"boolean"},"human_approval_required":{"type":"boolean","default":false},"allowed_tools":{"type":"array","items":{"type":"string"}}}},
    "upgrade_policy":{"type":"object","additionalProperties":false,"required":["allow_agent_upgrade","mode"],"properties":{"allow_agent_upgrade":{"type":"boolean"},"mode":{"enum":["never","suggest","automatic"]},"forced_reasons":{"type":"array","items":{"type":"string"}}}}
  }
}
