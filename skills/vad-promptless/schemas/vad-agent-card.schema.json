{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/draiagent/VAD-Promptless/blob/main/skills/vad-promptless/schemas/vad-agent-card.schema.json",
  "title": "Promptless VAD Agent Card Schema",
  "description": "VAD-Promptless v0.4.0 的 VAD Agent Card 機器可讀規格。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","card_type","id","name","metadata","goal","role","skills","tools","knowledge","workflow","decision","sub_agents","interoperability","qa_governance"],
  "properties": {
    "schema_version":{"const":"0.3.0"},"card_type":{"const":"agent"},
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},"name":{"type":"string","minLength":1},"description":{"type":"string"},"language":{"type":"string","default":"zh-TW"},
    "metadata":{"type":"object","additionalProperties":false,"required":["version"],"properties":{"version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"author":{"type":"string"},"license":{"type":"string"},"tags":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
    "goal":{"type":"object","additionalProperties":false,"required":["objective","success_definition"],"properties":{"objective":{"type":"string"},"success_definition":{"type":"string"},"stop_conditions":{"type":"array","items":{"type":"string"}}}},
    "role":{"type":"object","additionalProperties":false,"required":["responsibility","boundaries"],"properties":{"responsibility":{"type":"string"},"boundaries":{"type":"array","items":{"type":"string"}},"prohibited_actions":{"type":"array","items":{"type":"string"}}}},
    "skills":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id"],"properties":{"id":{"type":"string"},"required":{"type":"boolean","default":false},"source":{"type":"string"}}}},
    "tools":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id"],"properties":{"id":{"type":"string"},"purpose":{"type":"string"},"write_capable":{"type":"boolean","default":false},"approval_required":{"type":"boolean","default":false}}}},
    "knowledge":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","type"],"properties":{"id":{"type":"string"},"type":{"type":"string","enum":["context","file","rag","memory","database","policy","other"]},"source":{"type":"string"},"freshness":{"type":"string"}}}},
    "workflow":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","action"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9._-]+$"},"name":{"type":"string"},"action":{"type":"string","minLength":1},"condition":{"type":"string"},"skill":{"type":"string"},"tool":{"type":"string"},"input_refs":{"type":"array","items":{"type":"string"}},"output_refs":{"type":"array","items":{"type":"string"}},"on_failure":{"type":"string","enum":["stop","retry","human_review","continue","replan"]}}}},
    "decision":{"type":"object","additionalProperties":false,"required":["autonomy_level","rules","replanning_allowed"],"properties":{"autonomy_level":{"type":"integer","minimum":1,"maximum":5},"rules":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["when","then"],"properties":{"when":{"type":"string"},"then":{"type":"string"},"else":{"type":"string"},"requires_human":{"type":"boolean","default":false}}}},"replanning_allowed":{"type":"boolean"},"max_replans":{"type":"integer","minimum":0}}},
    "sub_agents":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","purpose"],"properties":{"id":{"type":"string"},"purpose":{"type":"string"},"delegation_condition":{"type":"string"},"max_depth":{"type":"integer","minimum":1,"maximum":5}}}},
    "interoperability":{"type":"object","additionalProperties":false,"required":["mcp","a2a"],"properties":{"mcp":{"type":"array","items":{"type":"string"}},"a2a":{"type":"array","items":{"type":"string"}}}},
    "qa_governance":{"type":"object","additionalProperties":false,"required":["checks","human_review","audit"],"properties":{"checks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","criterion","severity","method"],"properties":{"id":{"type":"string"},"criterion":{"type":"string"},"severity":{"type":"string","enum":["blocker","warning","info"]},"method":{"type":"string","enum":["schema","model","tool","human"]},"threshold":{"type":["number","string","boolean"]}}}},"human_review":{"type":"array","items":{"type":"string"}},"audit":{"type":"boolean"},"data_rules":{"type":"array","items":{"type":"string"}},"failure_policy":{"type":"string","enum":["stop","rollback","human_review","safe_degrade"]}}}
  }
}
