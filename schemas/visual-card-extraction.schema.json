{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/draiagent/Promptless-Skill/schemas/visual-card-extraction.schema.json",
  "title": "Promptless Visual Card Extraction Schema",
  "description": "v0.3.1 視覺模型從資訊卡圖片抽取出的中介資料格式。此層保留信心值與不確定項，再正規化為 Skill/Agent Card。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "intent", "fields", "confidence", "uncertainties"],
  "properties": {
    "schema_version": {"const": "0.3.1"},
    "source": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "image"}, "filename": {"type": "string"}, "mime_type": {"type": "string"}, "page": {"type": "integer", "minimum": 1}, "language_hint": {"type": "string"}}},
    "intent": {"type": "object", "additionalProperties": false, "required": ["candidate_type", "name", "objective"], "properties": {"candidate_type": {"enum": ["skill", "agent", "unknown"]}, "name": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}, "success_definition": {"type": "string"}}},
    "fields": {"type": "object", "additionalProperties": false, "properties": {"input": {"type": "array", "items": {"type": "string"}}, "style": {"type": "array", "items": {"type": "string"}}, "process": {"type": "array", "items": {"type": "string"}}, "output": {"type": "array", "items": {"type": "string"}}, "qa": {"type": "array", "items": {"type": "string"}}, "role": {"type": "string"}, "skills": {"type": "array", "items": {"type": "string"}}, "tools": {"type": "array", "items": {"type": "string"}}, "knowledge": {"type": "array", "items": {"type": "string"}}, "decisions": {"type": "array", "items": {"type": "string"}}, "sub_agents": {"type": "array", "items": {"type": "string"}}, "interoperability": {"type": "array", "items": {"type": "string"}}, "governance": {"type": "array", "items": {"type": "string"}}}},
    "signals": {"type": "object", "additionalProperties": false, "properties": {"dynamic_branching": {"type": "boolean"}, "dynamic_tool_selection": {"type": "boolean"}, "replanning": {"type": "boolean"}, "persistent_state": {"type": "boolean"}, "delegation": {"type": "boolean"}, "multi_agent": {"type": "boolean"}, "external_side_effects": {"type": "boolean"}, "human_approval_required": {"type": "boolean"}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainties": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["field", "reason"], "properties": {"field": {"type": "string"}, "reason": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "raw_text": {"type": "array", "items": {"type": "string"}}
  }
}
